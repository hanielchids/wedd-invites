# Photowall (/photobooth) — copy to .env.local and fill in from your Supabase project
# Project settings → API. The service-role key stays server-side; never NEXT_PUBLIC.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Any long random string; used to hide a photo from the wall
PHOTOWALL_ADMIN_KEY=change-me

# ── Thank-you mail merge (scripts/send-thankyous.mjs) ──────────────
# Google Sheet with Name / Email / Photos columns, shared "anyone with link can view"
THANKYOU_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR-SHEET-ID/edit
# SMTP relay — for Gmail: smtp.gmail.com + an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional overrides
# MAIL_FROM="Haniel & Zenzeleni" <you@gmail.com>
# MAIL_REPLY_TO=you@gmail.com
# MAIL_SUBJECT=Thank you for celebrating with us 🌿
