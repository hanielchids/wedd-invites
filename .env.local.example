# Photowall (/photobooth) — copy to .env.local and fill in from your Supabase project
# Project settings → API. The service-role key stays server-side; never NEXT_PUBLIC.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Any long random string; used to hide a photo from the wall
PHOTOWALL_ADMIN_KEY=change-me
